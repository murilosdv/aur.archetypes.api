meta {
  name: Authenticated, with a token
  type: http
  seq: 2
}

get {
  url: {{host}}/v1/playground/auth/authenticated
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bob}}
}

assert {
  res.status: eq 200
}

docs {
  Lists your claims: handy to see how Keycloak sends roles and scopes.
}
