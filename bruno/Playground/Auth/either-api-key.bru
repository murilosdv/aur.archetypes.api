meta {
  name: Either: the API key
  type: http
  seq: 7
}

get {
  url: {{host}}/v1/playground/auth/either
  body: none
  auth: none
}

headers {
  X-Api-Key: {{apiKey}}
}

assert {
  res.status: eq 200
}

docs {
  The local key from appsettings.Development.json works here; scope api.read comes from the settings of the key.
}
