meta {
  name: Create the profile of alice
  type: http
  seq: 2
}

put {
  url: {{host}}/v1/authors/me
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{alice}}
}

body:json {
  { "handle": "alice", "displayName": "Alice" }
}

assert {
  res.status: eq 200
}
