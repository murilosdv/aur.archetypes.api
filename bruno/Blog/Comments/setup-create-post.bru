meta {
  name: Setup: bob writes a post
  type: http
  seq: 1
}

post {
  url: {{host}}/v1/posts
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{bob}}
}

body:json {
  { "title": "A post to comment on", "body": "Comments need a published post." }
}

script:post-response {
  bru.setVar("commentsPostId", res.body.id);
}

assert {
  res.status: eq 201
}

docs {
  Only comments are tested in this folder, so it makes its own post.
}
