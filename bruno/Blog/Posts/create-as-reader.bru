meta {
  name: A reader cannot write
  type: http
  seq: 4
}

post {
  url: {{host}}/v1/posts
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{alice}}
}

body:json {
  { "title": "Not allowed", "body": "Readers do not write." }
}

assert {
  res.status: eq 403
}
