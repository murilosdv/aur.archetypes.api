meta {
  name: Bob changes only the title
  type: http
  seq: 8
}

patch {
  url: {{host}}/v1/posts/{{postId}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{bob}}
}

body:json {
  { "title": "Hello, world (edited)" }
}

assert {
  res.status: eq 200
}

docs {
  A PATCH: what is not sent stays, and so does the slug.
}
