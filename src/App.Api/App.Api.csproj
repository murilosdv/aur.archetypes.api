<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- The service version; CI overrides it: dotnet publish -p:Version=1.4.2 -->
    <Version>1.0.0</Version>
    <AssemblyName>Archetypes.Api</AssemblyName>
    <RootNamespace>Aurore.Archetypes.Api.App.Api</RootNamespace>
    <!-- Source-generated OpenAPI interceptors -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aurore.Archetypes.Api.Tests" />
    <InternalsVisibleTo Include="Aurore.Archetypes.Api.Tests.Integration" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aurore.Foundation.OpenApi.Scalar" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
    <ProjectReference Include="..\Features\Features.csproj" />
    <ProjectReference Include="..\Infra\Infra.csproj" />
  </ItemGroup>

</Project>
