<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AssemblyName>Archetypes.Api</AssemblyName>
    <RootNamespace>Aurore.Archetypes.Api.App.Api</RootNamespace>
    <!-- Service version (AppInformation.Version, telemetry, liveness). CI overrides it: dotnet publish -p:Version=1.4.2 -->
    <Version>1.0.0</Version>
    <!--Explicit permission used by OpenAPI source generation-->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aurore.Archetypes.Api.Tests" />
    <InternalsVisibleTo Include="Aurore.Archetypes.Api.Tests.Integration" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aurore.Foundation.OpenApi.Scalar" Version="1.0.0-preview.1" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
    <ProjectReference Include="..\Features\Features.csproj" />
    <ProjectReference Include="..\Infra\Infra.csproj" />
  </ItemGroup>

</Project>
