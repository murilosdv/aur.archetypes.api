{
  "AllowedHosts": "api.example.com",

  "Email": {
    "Host": "smtp.example.com",
    "Port": 587,
    "EnableSsl": true,
    "Username": "{{change-me}}",
    "Password": "{{change-me}}",
    "From": "archetypes-api@example.com",
    "ModeratorAddresses": [ "moderators@example.com" ]
  },

  "HttpDependencies": {
    "Orders": {
      "BaseUrl": "https://orders.example.com",
      "ClientCredentials": {
        "TokenUrl": "https://auth.example.com/realms/aurorelabs/protocol/openid-connect/token",
        "ClientSecret": "{{change-me}}"
      }
    },
    "Inventory": {
      "BaseUrl": "https://inventory.example.com",
      "ApiKey": {
        "Value": "{{change-me}}"
      }
    }
  },
  "IdentityProvider": {
    "AuthorityUrl": "https://auth.example.com/realms/aurorelabs",
    "RequireHttpsMetadata": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore.Authentication": "Warning",
      "Microsoft.IdentityModel": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Postgres": {
    "Host": "db.example.com",
    "Database": "archetypes-api",
    "Username": "archetypes-api",
    "Password": "{{change-me}}",
    "SslMode": "Require"
  },
  "RequestPipeline": {
    "Privacy": {
      "Enabled": true,
      "Keys": {
        "Current": "{{change-me}}"
      }
    },
    "ForwardedHeaders": {
      "KnownNetworks": [ "10.0.0.0/24" ]
    }
  },
  "Telemetry": {
    "Otlp": {
      "Endpoint": "http://otel-collector.example.com:4317"
    }
  }
}
