{
  "AllowedHosts": "api.example.com",
  "Email": {
    "Host": "smtp.example.com",
    "Username": "{{EMAIL_USERNAME}}",
    "Password": "{{EMAIL_PASSWORD}}",
    "From": "archetypes-api@example.com",
    "ModeratorAddresses": [
      "moderators@example.com"
    ]
  },
  "HttpDependencies": {
    "Orders": {
      "BaseUrl": "https://orders.example.com",
      "ClientCredentials": {
        "TokenUrl": "https://auth.example.com/realms/aurorelabs/protocol/openid-connect/token",
        "ClientSecret": "{{ORDERS_CLIENT_SECRET}}"
      }
    },
    "Inventory": {
      "BaseUrl": "https://inventory.example.com",
      "ApiKey": {
        "Value": "{{INVENTORY_API_KEY}}"
      }
    }
  },
  "IdentityProvider": {
    "AuthorityUrl": "https://auth.example.com/realms/aurorelabs"
  },
  "Postgres": {
    "Host": "db.example.com",
    "Database": "archetypes-api",
    "Username": "{{POSTGRES_USERNAME}}",
    "Password": "{{POSTGRES_PASSWORD}}",
    "SslMode": "Require"
  },
  "RequestPipeline": {
    "Privacy": {
      "Enabled": true,
      "Keys": {
        "Current": "{{PRIVACY_KEY}}"
      }
    },
    "ForwardedHeaders": {
      "KnownNetworks": [
        "10.0.0.0/24"
      ]
    }
  },
  "Telemetry": {
    "Otlp": {
      "Endpoint": "http://otel-collector.example.com:4317"
    }
  }
}
