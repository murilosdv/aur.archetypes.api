{
  "ApiKeys": {
    "Clients": {
      "local-tester": {
        "Key": "local-dev-api-key",
        "Roles": [
          "reader"
        ],
        "Scopes": [
          "api.read"
        ]
      }
    }
  },
  "Postgres": {
    "Host": "127.0.0.1",
    "Username": "postgres",
    "Password": "postgres"
  },
  "Email": {
    "Host": "127.0.0.1",
    "Port": 1025,
    "EnableSsl": false,
    "From": "archetypes-api@aurorelabs.com",
    "ModeratorAddresses": [
      "moderators@aurorelabs.com"
    ]
  },
  "HttpDependencies": {
    "Orders": {
      "BaseUrl": "http://orders.localhost:5002",
      "ClientCredentials": {
        "TokenUrl": "http://127.0.0.1:8080/realms/aurorelabs/protocol/openid-connect/token",
        "ClientSecret": "local-dev-secret"
      }
    },
    "Inventory": {
      "BaseUrl": "http://inventory.localhost:5003",
      "ApiKey": {
        "Value": "local-dev-inventory-key"
      }
    }
  },
  "IdentityProvider": {
    "AuthorityUrl": "http://127.0.0.1:8080/realms/aurorelabs",
    "RequireHttpsMetadata": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore.Authentication": "Information",
      "Microsoft.IdentityModel": "Debug",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore.Hosting": "Warning",
      "Microsoft.AspNetCore.Mvc": "Warning",
      "Microsoft.AspNetCore.Routing": "Warning",
      "Microsoft.EntityFrameworkCore": "Information",
      "Microsoft.EntityFrameworkCore.Update": "Critical",
      "Microsoft.AspNetCore.DataProtection": "Error",
      "System.Net.Http.HttpClient": "Information"
    }
  },
  "Telemetry": {
    "Otlp": {
      "Endpoint": "http://localhost:4317"
    }
  }
}
