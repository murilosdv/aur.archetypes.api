<Project>
  <!-- Central package management: every NuGet version of the solution is here; a project references a package without a version. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Aurore.Foundation.AspNetCore" Version="1.0.0-preview.3" />
    <PackageVersion Include="Aurore.Foundation.Core" Version="1.0.0-preview.3" />
    <PackageVersion Include="Aurore.Foundation.EntityFrameworkCore.Postgres" Version="1.0.0-preview.3" />
    <PackageVersion Include="Aurore.Foundation.OpenApi.Scalar" Version="1.0.0-preview.3" />
    <PackageVersion Include="Aurore.Foundation.Telemetry" Version="1.0.0-preview.3" />
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.3" />
  </ItemGroup>
</Project>